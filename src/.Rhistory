library(ggdendro)
# CPMの計算
d2 <- cpm(d1, normalized.lib.size = TRUE)
scaledata <- t(scale(t(AB2))) # Centers and scales data.
scaledata <- scaledata[complete.cases(scaledata), ]
scaledata <- t(scale(t(d2))) # Centers and scales data.
scaledata <- scaledata[complete.cases(scaledata), ]
hr <- hclust(as.dist(1 - cor(t(scaledata), method = "pearson")), method = "complete")
hc <- hclust(as.dist(1 - cor(scaledata, method = "spearman")), method = "complete")
# Cluster tree
geneTree <- as.dendrogram(hc, method = "average")
p <- ggdendrogram(geneTree, rotate = FALSE, size = 2)
ggsave(p, file = paste0("Cluster_", chr, ".png"), bg = "transparent", width = 10, height = 7)
ggsave(p, file = "Cluster.png", bg = "transparent", width = 10, height = 7)
p
# hirarchical clustering with heatmap
png("Cluster_hm.png")
heatmap.2(d2,
Rowv = as.dendrogram(hr),
Colv = as.dendrogram(hc),
col = colorRampPalette(c("blue", "yellow"))(100),
scale = "row",
cexCol = 0.7,
labRow = F,
main = "Heatmap.2",
trace = "none"
)
dev.off()
# DEGを検出 (FDR < 0.01)
FDR <- as.logical(table1$FDR < 0.01) # logical (true、false)の判定付きで変換。
DEG_names <- rownames(table1)[FDR] # trueだけDEG.namesに収納
# DEGを表に出力 (FDR < 0.01)
DEGs <- subset(table1, FDR < 0.001)
write.table(DEGs,
file = "DEGs.txt",
col.names = T, row.names = T, sep = "\t", quote = FALSE
)
# MA plot
plotSmear(lrt1, de.tags = DEG_names, cex = 0.3)
# MA plotを保存
png("MAplot.png", bg = "transparent")
print(plotSmear(lrt1, de.tags = DEG_names, cex = 0.3))
dev.off()
## volcano plot
